const int MAX_COLS = 1200;      // reicht fuer ~200 Zeichen
uint8_t banner[MAX_COLS];
int bannerLen = 0;

void buildBanner() {
  bannerLen = 0;
  for (unsigned int i = 0; i < strlen(TEXT); i++) {
    char ch = tolower((unsigned char) TEXT[i]);
    const char *p = strchr(FONT_CHARS, ch);
    int idx = p ? (int)(p - FONT_CHARS) : (int) strlen(FONT_CHARS) - 1;
    if (!p) { ch = ' '; p = strchr(FONT_CHARS, ' '); idx = (int)(p - FONT_CHARS); }
    for (int c = 0; c < FONT_W[idx] && bannerLen < MAX_COLS - 1; c++) {
      banner[bannerLen++] = FONT_C[idx][c];
    }
    if (bannerLen < MAX_COLS - 1) banner[bannerLen++] = 0;  // Zeichenabstand
  }
}

uint8_t frame[ROWS * COLS];

void setup() {
  matrix.begin();
  matrix.setGrayscaleBits(1);
  buildBanner();
}

void loop() {
  static int offset = -COLS;   // Text laeuft leer ein

  for (int x = 0; x < COLS; x++) {
    int src = offset + x;
    uint8_t col = (src >= 0 && src < bannerLen) ? banner[src] : 0;
    for (int y = 0; y < ROWS; y++) {
      frame[y * COLS + x] = (col >> y) & 1;
    }
  }
  matrix.draw(frame);

  offset++;
  if (offset > bannerLen) {
    offset = -COLS;            // von vorn
  }
  delay(SPEED_MS);
}
